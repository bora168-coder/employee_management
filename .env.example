# ---- Docker Compose (local PostgreSQL + MinIO) ----
# Copy to .env and set strong values: openssl rand -hex 24
# Use the same values in apps/api/.env (DATABASE_URL, S3_ACCESS_KEY, S3_SECRET_KEY).
POSTGRES_USER=csbms
POSTGRES_PASSWORD=
POSTGRES_DB=csbms

# MinIO password must be at least 8 characters
MINIO_ROOT_USER=csbms
MINIO_ROOT_PASSWORD=
