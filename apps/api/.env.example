# ---- NestJS API ----
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for CORS and CSRF origin check)
WEB_ORIGIN=http://localhost:3000

# Password = POSTGRES_PASSWORD from the root .env
DATABASE_URL=postgresql://csbms:CHANGE_ME@localhost:5432/csbms?schema=public
# Database for e2e tests (wiped on every run; name must contain "test")
TEST_DATABASE_URL=postgresql://csbms:CHANGE_ME@localhost:5432/csbms_test?schema=public

# Long random string: openssl rand -base64 48
# The API refuses to start in production with the example value.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false

# File storage: "local" (folder on disk) or "s3" (MinIO / S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD from the root .env
S3_ACCESS_KEY=csbms
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=csbms

# Chromium used to render PDFs (leave empty to use Playwright's default)
CHROMIUM_EXECUTABLE_PATH=

# Seed: first super admin account
SEED_ADMIN_USERNAME=admin
# Used once, when the admin user is created. Change it after the first login.
SEED_ADMIN_PASSWORD=ChangeMe123!
